# Copiar a .env solo para pruebas locales. En las rutinas de Claude estas variables se definen en el entorno.
# Registro de aplicación en Entra ID (lo crea el administrador del tenant)
M365_TENANT_ID=8ee8e831-5e5b-4eac-a4db-543128ab6b34
M365_CLIENT_ID=
M365_CLIENT_SECRET=

# Cuenta cuyo OneDrive y buzón usan las rutinas
M365_USUARIO=soluciones@arval.com.mx
CORREO_RESUMEN=ltorres@arval.com.mx

# Ubicación de los datos en OneDrive
RUTA_BASE=/Reembolsos
ARCHIVO_CONTROL=Control_Reembolsos.xlsx

# propone = no escribe nada en Microsoft 365 (primera semana); aplica = mueve archivos, actualiza Excel y envía correo
MODO=propone
CARPETA_TRABAJO=trabajo
PAGINAS_MAX=3

# Prefijo web de OneDrive para el botón "Abrir carpeta" del panel (se le pega la ruta codificada)
ONEDRIVE_WEB_BASE=https://arvalcommx-my.sharepoint.com/my?id=%2Fpersonal%2Fsoluciones%5Farval%5Fcom%5Fmx%2FDocuments
# URL del panel publicado (la usan las rutinas para escribir en su base de datos y el resumen para enlazarlo)
PANEL_URL=
